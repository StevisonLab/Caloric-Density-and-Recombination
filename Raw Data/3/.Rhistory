#Load necessary libraries
library(tidyverse)
library(ggplot2)
library(readxl)
library(emmeans)
library(multcomp)
library(multcompView)
library(lme4)
library(lmerTest)
library(car)
library(readr)
library(dplyr)
library(tidyr)   # for replace_na
library(broom)
# Read files and add a collector column
data1 <- read_csv("ZL-ExperimentDataEntry_Connor.csv") %>%
mutate(collector = "Connor")
data2 <- read_csv("ZL-ExperimentDataEntry_Laney.csv") %>%
mutate(collector = "Laney")
# Stack rows
merged_data <- bind_rows(data1, data2)
# Ensure proper types (fixed trailing comma removed)
merged_data <- merged_data %>%
mutate(
ID = as.character(ID),
Brood = as.character(Brood),
Female = as.numeric(Female),
Male = as.numeric(Male),
Dead = as.numeric(Dead))
# Read your treatment key
treatment_key <- read_csv("Key.csv") %>%
mutate(
ID = as.character(ID),
F1developmental = as.character(F1developmental),
F1Genotype = as.character(F1Genotype)
)
# Read egg counts
egg <- read_csv("Allegg.csv") %>%
mutate(
ID = as.character(ID),
Brood = as.character(Brood),
Eggcount = as.numeric(all_egg)
)
# Merge key  + data (by ID)
merged_data <- merged_data %>%
left_join(treatment_key, by = "ID")
# Merge egg  + data (by ID & Brood)
merged_data <- merged_data %>%
left_join(egg, by = c("ID", "Brood"))
# Remove rows where Female or Male are NA
merged_data <- merged_data %>%
filter(!is.na(Female) & !is.na(Male))
# Add Dead to female & male (split half-half), treating NA as 0
merged_data <- merged_data %>%
mutate(
Dead = replace_na(Dead, 0),
Female = Female + Dead / 2,
Male   = Male + Dead / 2
)
# Aggregate Data by ID & Brood & treatment/genotype
data_summary <- merged_data %>%
group_by(ID, Brood, F1developmental, F1Genotype, collector) %>%
summarise(
EggCount       = first(as.numeric(Eggcount)),
FemaleCount    = sum(Female, na.rm = TRUE),
MaleCount      = sum(Male, na.rm = TRUE),
TotalOffspring = FemaleCount + MaleCount,
.groups = "drop"
) %>%
mutate(
# Overall survival
Survival_Total = (TotalOffspring / EggCount) * 100,
Survival_Total = pmin(Survival_Total, 100),
# Female survival
Survival_Female = (FemaleCount / (0.5 * EggCount)) * 100,
Survival_Female = pmin(Survival_Female, 100),
# Male survival
Survival_Male = (MaleCount / (0.5 * EggCount)) * 100,
Survival_Male = pmin(Survival_Male, 100))
###_____________________________________
experiment_table <- merged_data %>%
mutate(
experiment_id  = "MS_6",
cross_id       = .data$ID,
brood_id       = .data$Brood,
vial_unique_id = paste("MS_6", .data$ID, .data$Brood, sep = "_"),
treatment_id   = paste(.data$F1developmental, .data$F1Genotype, sep = "_"),
data_collector = .data$collector
) %>%
group_by(
experiment_id,
cross_id,
brood_id,
vial_unique_id,
treatment_id,
data_collector
) %>%
summarise(
female_adult_count = sum(.data$Female, na.rm = TRUE),
male_adult_count   = sum(.data$Male, na.rm = TRUE),
total_adult_count  = sum(.data$Female + .data$Male, na.rm = TRUE),
.groups = "drop"
) %>%
# select is optional here; all columns already exist
select(
experiment_id,
cross_id,
brood_id,
vial_unique_id,
treatment_id,
data_collector,
female_adult_count,
male_adult_count,
total_adult_count
)
#markerfree----
# Read in csv files of raw count data from the marker free cross
CH_marker_free_egg_count <- read.csv("A_CH_raw_marker_free_egg_counts.csv", header=TRUE)
LM_marker_free_egg_count <- read.csv("B_LM_raw_marker_free_egg_counts.csv", header=TRUE)
LH_marker_free_egg_count <- read.csv("B_LH_raw_marker_free_egg_counts.csv", header=TRUE)
MS_marker_free_adult_count <- read.csv("C_MS_raw_marker_free_adult_counts.csv", header=TRUE)
# Compile the raw data from different observers and life history stages
CH_raw_marker_free_total_egg_count <- CH_marker_free_egg_count$total_egg_count
LM_raw_marker_free_total_egg_count <- LM_marker_free_egg_count$total_egg_count
LH_raw_marker_free_total_egg_count <- LH_marker_free_egg_count$total_egg_count
compiled_raw_marker_free_dataset <- cbind(MS_marker_free_adult_count, CH_raw_marker_free_total_egg_count, LM_raw_marker_free_total_egg_count)
compiled_raw_marker_free_dataset <- cbind(MS_marker_free_adult_count, CH_raw_marker_free_total_egg_count, LH_raw_marker_free_total_egg_count)
# Split treatment_id into treatment and genotype for marker-free dataset
treatment_genotype <- strsplit(as.character(compiled_raw_marker_free_dataset$treatment_id), "_")
compiled_raw_marker_free_dataset$treatment <- sapply(treatment_genotype, function(x) x[1])
compiled_raw_marker_free_dataset$genotype <- sapply(treatment_genotype, function(x) x[2])
write.csv(compiled_raw_marker_free_dataset, "../../Summaries and Outputs/D_compiled_raw_marker_free_dataset.csv", row.names = TRUE)
# Transform individual raw egg counts to address undercounting the average and round these two counts to the nearest whole number
CH_transformed_marker_free_total_egg_count <- (CH_raw_marker_free_total_egg_count - 6.479979) / 0.9224861
LM_transformed_marker_free_total_egg_count <- (LM_raw_marker_free_total_egg_count - 4.866269) / 0.8351445
LH_transformed_marker_free_total_egg_count <- (LH_raw_marker_free_total_egg_count - 2.5569307 ) / 0.8528595
transformed_mean_marker_free_total_egg_count <- round((CH_transformed_marker_free_total_egg_count + LM_transformed_marker_free_total_egg_count) / 2)
transformed_mean_marker_free_total_egg_count <- round((CH_transformed_marker_free_total_egg_count + LH_transformed_marker_free_total_egg_count) / 2)
derived_marker_free_dataset <- cbind(compiled_raw_marker_free_dataset, transformed_mean_marker_free_total_egg_count)
write.csv(derived_marker_free_dataset, "../../Summaries and Outputs/E_derived_marker_free_dataset.csv", row.names = TRUE)
# Calculate the per vial viability of females, males, and total under the 1:1 primary sex ratio assumption
derived_marker_free_female_viability <- derived_marker_free_dataset$female_adult_count / (derived_marker_free_dataset$transformed_mean_marker_free_total_egg_count / 2)
derived_marker_free_male_viability <- derived_marker_free_dataset$male_adult_count / (derived_marker_free_dataset$transformed_mean_marker_free_total_egg_count / 2)
derived_marker_free_total_viability <- derived_marker_free_dataset$total_adult_count / derived_marker_free_dataset$transformed_mean_marker_free_total_egg_count
marker_free_viability_dataset <- cbind(derived_marker_free_dataset, derived_marker_free_female_viability, derived_marker_free_male_viability, derived_marker_free_total_viability)
write.csv(marker_free_viability_dataset, "../../Summaries and Outputs/F_marker_free_viability_dataset.csv", row.names = TRUE)
#$#
marker_free_viability_long <- data.frame(
Cross = rep(marker_free_viability_dataset$cross_id, times = 2),
Brood = rep(marker_free_viability_dataset$brood_id, times = 2),
Treatment = rep(marker_free_viability_dataset$treatment, times = 2),
Genotype = rep(marker_free_viability_dataset$genotype, times = 2),
Sex = factor(
rep(c("Female", "Male"), each = nrow(marker_free_viability_dataset))
),
Viability = c(
marker_free_viability_dataset$derived_marker_free_female_viability,
marker_free_viability_dataset$derived_marker_free_male_viability
)
)
