# ---------- Load all KEGG files ----------
load_kegg <- function(file, comparison) {
path <- paste0(kegg_path, file)
if (!file.exists(path)) {
message("  [SKIP - not found] ", file)
return(data.frame())
}
df <- tryCatch(read_csv_file(path), error = function(e) data.frame())
if (nrow(df) == 0) {
message("  [SKIP - empty, nothing significant] ", file)
return(data.frame())
}
df$Comparison <- comparison
return(df)
}
# ---- Helper to build KEGG up/down data frame ----
prepare_kegg_comparison <- function(df, comparison_label) {
if (is.null(df) || nrow(df) == 0) return(data.frame())
up_df   <- df %>% filter(Up > 0)   %>% mutate(Direction = "Up-Regulated",   Comparison = comparison_label)
down_df <- df %>% filter(Down > 0) %>% mutate(Direction = "Down-Regulated", Comparison = comparison_label)
bind_rows(up_df, down_df)
}
