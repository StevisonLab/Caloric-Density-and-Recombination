nl(v_S399_HC_D2), nl(v_S399_LC_D2), nl(v_S399_LH_D2),
nl(v_S399_HC_D6), nl(v_S399_LC_D6), nl(v_S399_LH_D6),
ncol = 3, nrow = 2, align = "hv",
labels = c("Day 2", "", "", "Day 6", "", ""),
label_size = 16, label_fontface = "bold"
)
