mutate(
Genotype  = fix_geno(Genotype),
Treatment = fix_diet(treatment),
mass_mg   = Scale * 1000   # balance reads in grams
)
fig3a <- ggplot(body_mass, aes(x = Treatment, y = mass_mg, fill = Genotype)) +
geom_boxplot(width = 0.6, outlier.size = 1,
position = position_dodge(width = 0.7)) +
scale_fill_manual(values = geno_colors) +
labs(x = "Caloric density", y = "Female body mass (mg)", fill = "Genotype") +
theme_fig
# ---- (b-e) Volcano plots, LC vs HC ----
# Novogene "A vs B" files already report log2FoldChange = log2(A/B), so
# positive values are higher in LC. Do NOT flip the sign.
read_deg <- function(file) {
read.delim(file.path("Raw Data/RNA/DEG", file), sep = "\t",
check.names = FALSE, stringsAsFactors = FALSE, quote = "")
}
volcano_sets <- tribble(
~file,                            ~Genotype,  ~Day,
"S42_LC_D2vsS42_HC_D2_deg.xls",   "DGRP_42",  "Day 2",
"S42_LC_D6vsS42_HC_D6_deg.xls",   "DGRP_42",  "Day 6",
"S399_LC_D2vsS399_HC_D2_deg.xls", "DGRP_399", "Day 2",
"S399_LC_D6vsS399_HC_D6_deg.xls", "DGRP_399", "Day 6"
)
p_threshold      <- 0.05
log2fc_threshold <- 1
volcano_colors <- c("Higher in low calorie"  = "#2166ac",
"Higher in high calorie" = "#b2182b",
"Not significant"        = "gray75")
volcano_data <- volcano_sets %>%
rowwise() %>%
reframe(read_deg(file) %>%
select(gene_name, log2FoldChange, padj) %>%
mutate(Genotype = Genotype, Day = Day)) %>%
filter(!is.na(padj), !is.na(log2FoldChange)) %>%
mutate(
neglog10p = -log10(padj),
Status = case_when(
padj < p_threshold & log2FoldChange >  log2fc_threshold ~ "Higher in low calorie",
padj < p_threshold & log2FoldChange < -log2fc_threshold ~ "Higher in high calorie",
TRUE ~ "Not significant"),
Status = factor(Status, levels = names(volcano_colors))
)
# Shared limits so the four panels are directly comparable
x_lim <- c(-10, 10)
y_lim <- c(0, max(volcano_data$neglog10p[is.finite(volcano_data$neglog10p)]) * 1.05)
# Label the top 5 genes on each side by adjusted p-value
volcano_labels <- volcano_data %>%
filter(Status != "Not significant") %>%
group_by(Genotype, Day, Status) %>%
slice_min(padj, n = 5, with_ties = FALSE) %>%
ungroup()
make_volcano <- function(geno, day) {
d  <- filter(volcano_data, Genotype == geno, Day == day)
lb <- filter(volcano_labels, Genotype == geno, Day == day)
ggplot(d, aes(x = log2FoldChange, y = neglog10p, color = Status)) +
geom_point(data = filter(d, Status == "Not significant"),
size = 0.8, alpha = 0.5) +
geom_point(data = filter(d, Status != "Not significant"),
size = 1.2, alpha = 0.8) +
geom_hline(yintercept = -log10(p_threshold), linetype = "dashed",
color = "gray40", linewidth = 0.3) +
geom_vline(xintercept = c(-log2fc_threshold, log2fc_threshold),
linetype = "dashed", color = "gray40", linewidth = 0.3) +
geom_text_repel(data = lb, aes(label = gene_name), size = 2.6,
fontface = "italic", color = "black",
segment.color = "gray50", segment.size = 0.3,
min.segment.length = 0, max.overlaps = Inf,
seed = 1) +
scale_color_manual(values = volcano_colors, drop = FALSE) +
coord_cartesian(xlim = x_lim, ylim = y_lim) +
labs(title = paste(geno, day, sep = ", "),
x = expression(log[2]~"fold change (LC/HC)"),
y = expression(-log[10]~"adjusted"~italic(P)),
color = NULL) +
theme_fig
}
# Drop repeated axis titles: x only on the bottom row, y only on the left
no_x <- theme(axis.title.x = element_blank())
no_y <- theme(axis.title.y = element_blank())
fig3 <- fig3a +
(make_volcano("DGRP_42",  "Day 2") + no_x) +
(make_volcano("DGRP_42",  "Day 6") + no_x + no_y) +
make_volcano("DGRP_399", "Day 2") +
(make_volcano("DGRP_399", "Day 6") + no_y) +
plot_layout(design = "AA\nBC\nDE", heights = c(0.8, 1, 1), guides = "collect") +
plot_annotation(tag_levels = "a")
ggsave(paste0(out_dir, "Figure3_bodymass_volcano.pdf"), fig3,
width = 7.5, height = 9, device = cairo_pdf)
ggsave(paste0(out_dir, "Figure3_bodymass_volcano.png"), fig3,
width = 7.5, height = 9, dpi = 300)
deg_genes <- function(file) {
read_deg(file) %>%
filter(!is.na(padj), padj < p_threshold,
abs(log2FoldChange) > log2fc_threshold) %>%
pull(gene_id) %>% unique()
}
comparisons <- c("HC vs Control" = "HC_%s_vs_C_%s",
"LC vs Control" = "LC_%s_vs_C_%s",
"LC vs HC"      = "LC_%s_vs_HC_%s")
deg_file <- function(geno, comp, day) {
s <- paste0("S", geno)
switch(comp,
"HC vs Control" = sprintf("%s_HC_%svs%s_C_%s_deg.xls",  s, day, s, day),
"LC vs Control" = sprintf("%s_LC_%svs%s_C_%s_deg.xls",  s, day, s, day),
"LC vs HC"      = sprintf("%s_LC_%svs%s_HC_%s_deg.xls", s, day, s, day))
}
upset_data <- function(geno) {
long <- expand_grid(Comparison = names(comparisons), Day = c("D2", "D6")) %>%
rowwise() %>%
reframe(gene_id = deg_genes(deg_file(geno, Comparison, Day)),
Comparison = Comparison, Day = Day) %>%
mutate(Day = recode(Day, D2 = "Day 2", D6 = "Day 6"))
# Within each day: intersection = the exact set of comparisons a gene is DE in
bars <- long %>%
group_by(Day, gene_id) %>%
summarise(Intersection = paste(sort(unique(Comparison)), collapse = " & "),
.groups = "drop") %>%
count(Day, Intersection) %>%
complete(Day, Intersection, fill = list(n = 0))
order <- bars %>% group_by(Intersection) %>%
summarise(total = sum(n)) %>% arrange(desc(total)) %>% pull(Intersection)
sets <- count(long, Day, Comparison)
list(bars = bars, order = order, sets = sets)
}
make_upset <- function(geno, fills) {
u <- upset_data(geno)
set_levels <- rev(names(comparisons))  # LC vs HC on top, as in the draft
bars <- mutate(u$bars, Intersection = factor(Intersection, levels = u$order))
bar_dodge <- position_dodge(width = 0.8)
p_bars <- ggplot(bars, aes(x = Intersection, y = n, fill = Day)) +
geom_col(width = 0.75, position = bar_dodge, color = "black", linewidth = 0.2) +
geom_text(aes(label = n), position = bar_dodge, vjust = -0.4, size = 2.5) +
scale_fill_manual(values = fills) +
scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
labs(x = NULL, y = "Intersection size", fill = paste0("DGRP_", geno)) +
theme_fig +
theme(axis.text.x = element_blank(), axis.ticks.x = element_blank(),
axis.line.x = element_blank())
dots <- expand_grid(Intersection = factor(u$order, levels = u$order),
Comparison = factor(names(comparisons), levels = set_levels)) %>%
mutate(Member = mapply(function(i, c) c %in% strsplit(i, " & ")[[1]],
as.character(Intersection), as.character(Comparison)))
p_dots <- ggplot(dots, aes(x = Intersection, y = Comparison)) +
annotate("rect", xmin = -Inf, xmax = Inf, ymin = c(0.5, 2.5), ymax = c(1.5, 3.5),
fill = "gray95") +
geom_line(data = filter(dots, Member), aes(group = Intersection),
linewidth = 0.8) +
geom_point(aes(color = Member), size = 3) +
scale_color_manual(values = c(`TRUE` = "black", `FALSE` = "gray80"), guide = "none") +
labs(x = NULL, y = NULL) +
theme_fig +
theme(axis.text.x = element_blank(), axis.ticks = element_blank(),
axis.line = element_blank())
sets <- mutate(u$sets, Comparison = factor(Comparison, levels = set_levels))
p_sets <- ggplot(sets, aes(y = Comparison, x = n, fill = Day)) +
geom_col(width = 0.7, position = position_dodge(width = 0.75),
color = "black", linewidth = 0.2, show.legend = FALSE) +
scale_x_reverse(expand = expansion(mult = c(0.05, 0))) +
scale_fill_manual(values = fills) +
labs(x = "Set size", y = NULL) +
theme_fig +
theme(axis.text.y = element_blank(), axis.ticks.y = element_blank(),
axis.line.y = element_blank())
plot_spacer() + p_bars + p_sets + p_dots +
plot_layout(widths = c(1, 3), heights = c(3, 1), guides = "collect")
}
fills_42  <- c("Day 2" = "#ffbb00", "Day 6" = "#ff7f00")
fills_399 <- c("Day 2" = "#CCA6D2", "Day 6" = "#984ea3")
fig4 <- wrap_elements(full = make_upset("42",  fills_42))  + labs(tag = "a") +
wrap_elements(full = make_upset("399", fills_399)) + labs(tag = "b") +
plot_layout(ncol = 1) &
theme(plot.tag = element_text(size = 16, face = "bold"))
ggsave(paste0(out_dir, "Figure4_upset.pdf"), fig4,
width = 7.5, height = 8, device = cairo_pdf)
ggsave(paste0(out_dir, "Figure4_upset.png"), fig4,
width = 7.5, height = 8, dpi = 300)
# ============================================================
# FIGURE 6: fitness components and recombination
# ============================================================
life_history <- read.csv("Summaries and Outputs/3/42_Life_History_All_Cleaned.csv") %>%
mutate(Genotype  = fix_geno(Genotype),
Treatment = fix_diet(Treatment),
Dataset   = factor(Dataset, levels = c("Marker-free", "Marker-present")))
lh_panel <- function(dataset, yvar, ylab, ylim) {
reaction_norm(filter(life_history, Dataset == dataset), yvar, ylab, ylim)
}
fec_max <- 60  # common y-range for both fecundity panels
fig6a <- lh_panel("Marker-free",    "Fecundity", "Eggs per female per day", c(0, fec_max)) +
ggtitle("Marker-free")
fig6b <- lh_panel("Marker-present", "Fecundity", "Eggs per female per day", c(0, fec_max)) +
ggtitle("Marker-present")
fig6c <- lh_panel("Marker-free",    "Viability", "Egg-to-adult survival (%)", c(0, 100))
fig6d <- lh_panel("Marker-present", "Viability", "Egg-to-adult survival (%)", c(0, 100))
# (e) Viability-corrected X-chromosome map length (counting model MLE).
# 23_df_RR_cleaned.csv is the outlier-filtered dataset used for the GLMM;
# plotted as mean +/- SE (the draft version plotted the median).
rr <- read.csv("Summaries and Outputs/3/23_df_RR_cleaned.csv") %>%
mutate(Genotype  = fix_geno(GB),
Treatment = fix_diet(Diet))
fig6e <- reaction_norm(rr, "recombination_fractions",
"X-chromosome map length (cM)") +
ggtitle("Recombination rate")
fig6 <- ((fig6a + no_x) | (fig6b + no_x + no_y)) /
((fig6c + no_x) | (fig6d + no_x + no_y)) /
fig6e +
plot_layout(guides = "collect", heights = c(1, 1, 1)) +
plot_annotation(tag_levels = "a") &
theme(legend.position = "bottom")
ggsave(paste0(out_dir, "Figure6_fitness_recombination.pdf"), fig6,
width = 7, height = 8.5, device = cairo_pdf)
ggsave(paste0(out_dir, "Figure6_fitness_recombination.png"), fig6,
width = 7, height = 8.5, dpi = 300)
# ============================================================
# Multi-panel Figures 3, 4 and 6 for the caloric density paper
#
# Builds each figure entirely in R (no PowerPoint assembly) with
# panel letters, shared axes and one legend per figure.
#
#   Figure 3: (a) body mass; (b-e) LC vs HC volcano plots,
#             DGRP_42 / DGRP_399 x Day 2 / Day 6
#   Figure 4: UpSet plots of DEG overlap, bars split by day,
#             (a) DGRP_42, (b) DGRP_399
#   Figure 6: (a-d) fecundity and survival, marker-free vs
#             marker-present; (e) viability-corrected map length
#
# Inputs are files already in the repository (Raw Data/ and
# Summaries and Outputs/3/). Run from the repository root.
# ============================================================
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggrepel)
library(patchwork)   # >= 1.2 for axes = "collect"
repo_dir <- "~/GitHub/Caloric-Density-and-Recombination"
setwd(repo_dir)
out_dir <- "Summaries and Outputs/Figures/"
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
# ------------------------------------------------------------
# Shared style
# ------------------------------------------------------------
geno_colors <- c("DGRP_42" = "#ff7f00", "DGRP_399" = "#984ea3")
diet_levels <- c("0.5x", "1.0x", "2.0x")
diet_labels <- c("0.5×", "1.0×", "2.0×")
theme_fig <- theme_classic(base_size = 11) +
theme(
axis.text        = element_text(color = "black"),
axis.ticks       = element_line(color = "black"),
plot.title       = element_text(size = 11, face = "bold", hjust = 0.5),
strip.background = element_blank(),
strip.text       = element_text(size = 11, face = "bold"),
legend.title     = element_text(face = "bold"),
plot.tag         = element_text(size = 16, face = "bold")
)
# Genotype codes in the data are "42"/"399"; display as DGRP_42/DGRP_399
fix_geno <- function(x) factor(paste0("DGRP_", x), levels = names(geno_colors))
fix_diet <- function(x) factor(x, levels = diet_levels, labels = diet_labels)
# Mean +/- SE reaction norm, dodged so the two genotypes don't overlap.
# Broods from the same vial are not independent, so broods are averaged
# within each vial first and the SE is taken across vials (the unit of
# replication, matching the vial random effect in the models).
dodge <- position_dodge(width = 0.25)
reaction_norm <- function(df, yvar, ylab, ylim = NULL) {
vial_means <- df %>%
filter(is.finite(.data[[yvar]])) %>%
group_by(Genotype, Treatment, vialID) %>%
summarise(y = mean(.data[[yvar]]), .groups = "drop")
p <- ggplot(vial_means, aes(x = Treatment, y = y,
color = Genotype, group = Genotype)) +
stat_summary(fun = mean, geom = "line", linewidth = 1, position = dodge) +
stat_summary(fun = mean, geom = "point", size = 2, position = dodge) +
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2,
linewidth = 0.6, position = dodge) +
scale_color_manual(values = geno_colors) +
labs(x = "Caloric density", y = ylab, color = "Genotype") +
theme_fig
if (!is.null(ylim)) p <- p + coord_cartesian(ylim = ylim)
p
}
# ============================================================
# FIGURE 3: body mass + volcano plots
# ============================================================
# ---- (a) Body mass ----
body_mass <- read.csv("Raw Data/3/BodyMass.csv", check.names = FALSE,
fileEncoding = "UTF-8-BOM") %>%
left_join(read.csv("Raw Data/3/BodyMasscross.csv",
fileEncoding = "UTF-8-BOM"), by = "ID") %>%
mutate(Scale = suppressWarnings(as.numeric(Scale))) %>%  # "-" = not weighed
filter(!is.na(Scale)) %>%
mutate(
Genotype  = fix_geno(Genotype),
Treatment = fix_diet(treatment),
mass_mg   = Scale * 1000   # balance reads in grams
)
fig3a <- ggplot(body_mass, aes(x = Treatment, y = mass_mg, fill = Genotype)) +
geom_boxplot(width = 0.6, outlier.size = 1,
position = position_dodge(width = 0.7)) +
scale_fill_manual(values = geno_colors) +
labs(x = "Caloric density", y = "Female body mass (mg)", fill = "Genotype") +
theme_fig
# ---- (b-e) Volcano plots, LC vs HC ----
# Novogene "A vs B" files already report log2FoldChange = log2(A/B), so
# positive values are higher in LC. Do NOT flip the sign.
read_deg <- function(file) {
read.delim(file.path("Raw Data/RNA/DEG", file), sep = "\t",
check.names = FALSE, stringsAsFactors = FALSE, quote = "")
}
volcano_sets <- tribble(
~file,                            ~Genotype,  ~Day,
"S42_LC_D2vsS42_HC_D2_deg.xls",   "DGRP_42",  "Day 2",
"S42_LC_D6vsS42_HC_D6_deg.xls",   "DGRP_42",  "Day 6",
"S399_LC_D2vsS399_HC_D2_deg.xls", "DGRP_399", "Day 2",
"S399_LC_D6vsS399_HC_D6_deg.xls", "DGRP_399", "Day 6"
)
p_threshold      <- 0.05
log2fc_threshold <- 1
volcano_colors <- c("Higher in low calorie"  = "#2166ac",
"Higher in high calorie" = "#b2182b",
"Not significant"        = "gray75")
volcano_data <- volcano_sets %>%
rowwise() %>%
reframe(read_deg(file) %>%
select(gene_name, log2FoldChange, padj) %>%
mutate(Genotype = Genotype, Day = Day)) %>%
filter(!is.na(padj), !is.na(log2FoldChange)) %>%
mutate(
neglog10p = -log10(padj),
Status = case_when(
padj < p_threshold & log2FoldChange >  log2fc_threshold ~ "Higher in low calorie",
padj < p_threshold & log2FoldChange < -log2fc_threshold ~ "Higher in high calorie",
TRUE ~ "Not significant"),
Status = factor(Status, levels = names(volcano_colors))
)
# Shared limits so the four panels are directly comparable
x_lim <- c(-10, 10)
y_lim <- c(0, max(volcano_data$neglog10p[is.finite(volcano_data$neglog10p)]) * 1.05)
# Label the top 5 genes on each side by adjusted p-value
volcano_labels <- volcano_data %>%
filter(Status != "Not significant") %>%
group_by(Genotype, Day, Status) %>%
slice_min(padj, n = 5, with_ties = FALSE) %>%
ungroup()
make_volcano <- function(geno, day) {
d  <- filter(volcano_data, Genotype == geno, Day == day)
lb <- filter(volcano_labels, Genotype == geno, Day == day)
ggplot(d, aes(x = log2FoldChange, y = neglog10p, color = Status)) +
geom_point(data = filter(d, Status == "Not significant"),
size = 0.8, alpha = 0.5) +
geom_point(data = filter(d, Status != "Not significant"),
size = 1.2, alpha = 0.8) +
geom_hline(yintercept = -log10(p_threshold), linetype = "dashed",
color = "gray40", linewidth = 0.3) +
geom_vline(xintercept = c(-log2fc_threshold, log2fc_threshold),
linetype = "dashed", color = "gray40", linewidth = 0.3) +
geom_text_repel(data = lb, aes(label = gene_name), size = 2.6,
fontface = "italic", color = "black",
segment.color = "gray50", segment.size = 0.3,
min.segment.length = 0, max.overlaps = Inf,
seed = 1) +
scale_color_manual(values = volcano_colors, drop = FALSE) +
coord_cartesian(xlim = x_lim, ylim = y_lim) +
labs(title = paste(geno, day, sep = ", "),
x = expression(log[2]~"fold change (LC/HC)"),
y = expression(-log[10]~"adjusted"~italic(P)),
color = NULL) +
theme_fig
}
# Drop repeated axis titles: x only on the bottom row, y only on the left
no_x <- theme(axis.title.x = element_blank())
no_y <- theme(axis.title.y = element_blank())
fig3 <- fig3a +
(make_volcano("DGRP_42",  "Day 2") + no_x) +
(make_volcano("DGRP_42",  "Day 6") + no_x + no_y) +
make_volcano("DGRP_399", "Day 2") +
(make_volcano("DGRP_399", "Day 6") + no_y) +
plot_layout(design = "AA\nBC\nDE", heights = c(0.8, 1, 1), guides = "collect") +
plot_annotation(tag_levels = "a")
ggsave(paste0(out_dir, "Figure3_bodymass_volcano.pdf"), fig3,
width = 7.5, height = 9, device = cairo_pdf)
ggsave(paste0(out_dir, "Figure3_bodymass_volcano.png"), fig3,
width = 7.5, height = 9, dpi = 300)
# ============================================================
# FIGURE 4: UpSet plots, Day 2 and Day 6 side by side
# ============================================================
# Intersections are computed within each day (a gene's membership
# on Day 2 is never mixed with Day 6), so every bar matches the
# per-day counts reported in the Results. Intersections are sorted
# by their combined size; each bar stays tied to its own dot column
# because bars and dots share the same factor levels.
deg_genes <- function(file) {
read_deg(file) %>%
filter(!is.na(padj), padj < p_threshold,
abs(log2FoldChange) > log2fc_threshold) %>%
pull(gene_id) %>% unique()
}
comparisons <- c("HC vs Control" = "HC_%s_vs_C_%s",
"LC vs Control" = "LC_%s_vs_C_%s",
"LC vs HC"      = "LC_%s_vs_HC_%s")
deg_file <- function(geno, comp, day) {
s <- paste0("S", geno)
switch(comp,
"HC vs Control" = sprintf("%s_HC_%svs%s_C_%s_deg.xls",  s, day, s, day),
"LC vs Control" = sprintf("%s_LC_%svs%s_C_%s_deg.xls",  s, day, s, day),
"LC vs HC"      = sprintf("%s_LC_%svs%s_HC_%s_deg.xls", s, day, s, day))
}
upset_data <- function(geno) {
long <- expand_grid(Comparison = names(comparisons), Day = c("D2", "D6")) %>%
rowwise() %>%
reframe(gene_id = deg_genes(deg_file(geno, Comparison, Day)),
Comparison = Comparison, Day = Day) %>%
mutate(Day = recode(Day, D2 = "Day 2", D6 = "Day 6"))
# Within each day: intersection = the exact set of comparisons a gene is DE in
bars <- long %>%
group_by(Day, gene_id) %>%
summarise(Intersection = paste(sort(unique(Comparison)), collapse = " & "),
.groups = "drop") %>%
count(Day, Intersection) %>%
complete(Day, Intersection, fill = list(n = 0))
order <- bars %>% group_by(Intersection) %>%
summarise(total = sum(n)) %>% arrange(desc(total)) %>% pull(Intersection)
sets <- count(long, Day, Comparison)
list(bars = bars, order = order, sets = sets)
}
make_upset <- function(geno, fills) {
u <- upset_data(geno)
set_levels <- rev(names(comparisons))  # LC vs HC on top, as in the draft
bars <- mutate(u$bars, Intersection = factor(Intersection, levels = u$order))
bar_dodge <- position_dodge(width = 0.8)
p_bars <- ggplot(bars, aes(x = Intersection, y = n, fill = Day)) +
geom_col(width = 0.75, position = bar_dodge, color = "black", linewidth = 0.2) +
geom_text(aes(label = n), position = bar_dodge, vjust = -0.4, size = 2.5) +
scale_fill_manual(values = fills) +
scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
labs(x = NULL, y = "Intersection size", fill = paste0("DGRP_", geno)) +
theme_fig +
theme(axis.text.x = element_blank(), axis.ticks.x = element_blank(),
axis.line.x = element_blank())
dots <- expand_grid(Intersection = factor(u$order, levels = u$order),
Comparison = factor(names(comparisons), levels = set_levels)) %>%
mutate(Member = mapply(function(i, c) c %in% strsplit(i, " & ")[[1]],
as.character(Intersection), as.character(Comparison)))
p_dots <- ggplot(dots, aes(x = Intersection, y = Comparison)) +
annotate("rect", xmin = -Inf, xmax = Inf, ymin = c(0.5, 2.5), ymax = c(1.5, 3.5),
fill = "gray95") +
geom_line(data = filter(dots, Member), aes(group = Intersection),
linewidth = 0.8) +
geom_point(aes(color = Member), size = 3) +
scale_color_manual(values = c(`TRUE` = "black", `FALSE` = "gray80"), guide = "none") +
labs(x = NULL, y = NULL) +
theme_fig +
theme(axis.text.x = element_blank(), axis.ticks = element_blank(),
axis.line = element_blank())
sets <- mutate(u$sets, Comparison = factor(Comparison, levels = set_levels))
p_sets <- ggplot(sets, aes(y = Comparison, x = n, fill = Day)) +
geom_col(width = 0.7, position = position_dodge(width = 0.75),
color = "black", linewidth = 0.2, show.legend = FALSE) +
scale_x_reverse(expand = expansion(mult = c(0.05, 0))) +
scale_fill_manual(values = fills) +
labs(x = "Set size", y = NULL) +
theme_fig +
theme(axis.text.y = element_blank(), axis.ticks.y = element_blank(),
axis.line.y = element_blank())
plot_spacer() + p_bars + p_sets + p_dots +
plot_layout(widths = c(1, 3), heights = c(3, 1), guides = "collect")
}
fills_42  <- c("Day 2" = "#ffbb00", "Day 6" = "#ff7f00")
fills_399 <- c("Day 2" = "#CCA6D2", "Day 6" = "#984ea3")
fig4 <- wrap_elements(full = make_upset("42",  fills_42))  + labs(tag = "a") +
wrap_elements(full = make_upset("399", fills_399)) + labs(tag = "b") +
plot_layout(ncol = 1) &
theme(plot.tag = element_text(size = 16, face = "bold"))
ggsave(paste0(out_dir, "Figure4_upset.pdf"), fig4,
width = 7.5, height = 8, device = cairo_pdf)
ggsave(paste0(out_dir, "Figure4_upset.png"), fig4,
width = 7.5, height = 8, dpi = 300)
# ============================================================
# FIGURE 6: fitness components and recombination
# ============================================================
life_history <- read.csv("Summaries and Outputs/3/42_Life_History_All_Cleaned.csv") %>%
mutate(Genotype  = fix_geno(Genotype),
Treatment = fix_diet(Treatment),
Dataset   = factor(Dataset, levels = c("Marker-free", "Marker-present")))
lh_panel <- function(dataset, yvar, ylab, ylim) {
reaction_norm(filter(life_history, Dataset == dataset), yvar, ylab, ylim)
}
fec_max <- 60  # common y-range for both fecundity panels
fig6a <- lh_panel("Marker-free",    "Fecundity", "Eggs per female", c(0, fec_max)) +
ggtitle("Marker-free")
fig6b <- lh_panel("Marker-present", "Fecundity", "Eggs per female", c(0, fec_max)) +
ggtitle("Marker-present")
fig6c <- lh_panel("Marker-free",    "Viability", "Egg-to-adult survival (%)", c(0, 100))
fig6d <- lh_panel("Marker-present", "Viability", "Egg-to-adult survival (%)", c(0, 100))
# (e) Viability-corrected X-chromosome map length (counting model MLE).
# 23_df_RR_cleaned.csv is the outlier-filtered dataset used for the GLMM;
# plotted as mean +/- SE (the draft version plotted the median).
rr <- read.csv("Summaries and Outputs/3/23_df_RR_cleaned.csv") %>%
mutate(Genotype  = fix_geno(GB),
Treatment = fix_diet(Diet))
fig6e <- reaction_norm(rr, "recombination_fractions",
"X-chromosome map length (cM)") +
ggtitle("Recombination rate")
fig6 <- ((fig6a + no_x) | (fig6b + no_x + no_y)) /
((fig6c + no_x) | (fig6d + no_x + no_y)) /
fig6e +
plot_layout(guides = "collect", heights = c(1, 1, 1)) +
plot_annotation(tag_levels = "a") &
theme(legend.position = "bottom")
ggsave(paste0(out_dir, "Figure6_fitness_recombination.pdf"), fig6,
width = 7, height = 8.5, device = cairo_pdf)
ggsave(paste0(out_dir, "Figure6_fitness_recombination.png"), fig6,
width = 7, height = 8.5, dpi = 300)
