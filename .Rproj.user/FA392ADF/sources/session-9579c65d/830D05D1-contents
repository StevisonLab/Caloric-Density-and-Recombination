# 3. ANOVA
anova_model_Fecundity <- aov(fecundity ~ `F1 Genotype` * `F1 developmental` * Brood ,data = fecundity_data)
summary(anova_model_Fecundity)
anova_summary <- tidy(anova_model_Fecundity) %>%
  mutate(
    significance = case_when(
      p.value < 0.001 ~ "***",
      p.value < 0.01  ~ "**",
      p.value < 0.05  ~ "*",
      p.value < 0.1   ~ ".",
      TRUE ~ ""
    )
  )
write.csv(anova_summary, "../Statistical Analysis/anova_model_Fecundity.csv", row.names = FALSE)

# Estimated marginal means for the interaction
emm_Fecundity <- emmeans(anova_model_Fecundity, ~ `F1 Genotype` * `F1 developmental`)

