  summarise( treatment_id       = first(treatment_id),
             data_collector     = first(data_collector),
             total_adult_count  = sum(total_adult_count, na.rm = TRUE),
             .groups = "drop")%>%
  select(
    cross_id,
    treatment_id,
    data_collector,
    total_adult_count
  )

write_csv(entries_final_vail,"3_MS_sampleize_brood_pooled.csv")
#sample size based each person and treatment----------
entries_final_cross <- entries_final %>%
  group_by(brood_id,data_collector, treatment_id)%>%
  summarise( cross_id = first(cross_id),
    total_adult_count  = sum(total_adult_count, na.rm = TRUE),
             .groups = "drop") %>%
  select(
    cross_id,
    brood_id,
    treatment_id,
    data_collector,
    total_adult_count
  )

write_csv(entries_final_cross,"3_MS_sampleize_cross&person_pooled.csv")
#sample size based each person and treatment and brood
