# 1. Read and prepare main data
df <- read.csv("Nutrition_countingmodel_outputs_all.csv")
df <- df %>% extract(original_ID,
into = c("experiment", "vialID", "Brood"),
regex = "^(.*)_([0-9]+)_([A-Za-z])$"
