# SAVE ALL ANOVA RESULTS
# -----------------------------
sink("../../Summaries and Outputs/3/23_life_history_ANOVA_results.csv")
for (name in names(anova_results)) {
cat("\n=============================\n")
cat(name, "\n")
cat("=============================\n")
print(anova_results[[name]])
}
sink()
