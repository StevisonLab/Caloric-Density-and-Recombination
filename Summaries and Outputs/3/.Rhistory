# If any number > 0, it's a recombinant fly
if (any(nums > 0)) {
interval_membership$is_recombinant[i] <- 1
# Flip the mapping for intervals as requested: 5->1 (y-cv), 1->5 (car-y+)
flipped_nums <- 6 - nums
for (val in flipped_nums) {
interval_membership[i, paste0("I", val)] <- 1
}
}
}
