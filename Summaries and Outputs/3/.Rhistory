color = as.factor(Genotype)))+geom_point(size = 6)+ geom_line(linewidth = 3)+
geom_errorbar(aes(ymin = mean_RR - se_RR, ymax = mean_RR + se_RR), width = 0.55) +
#  ylim(65,110)+
# Add equation
annotate(
"text",
x = 2,          # adjust if needed
