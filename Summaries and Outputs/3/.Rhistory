if (str_detect(str_segment, "_HC_|_HC$")) return("High Calorie")
return("Unknown")
}
comp <- paste0(extract_trt(left), " vs ", extract_trt(right))
# FIXED: Removed the 'day <- "D2"' override step to preserve your dynamic days
}
return(paste(genotype, "-", comp, "-", day_label))
}
# FIXED: Passed the 'day' column explicitly into the function evaluation rowwise
deg_meta <- deg_meta %>%
rowwise() %>%
mutate(
comparison_label = make_pretty_label(comparison, genotype, experiment, day)
) %>%
ungroup()
cat("\n=== Orientation check per comparison ===\n")
print(deg_meta %>% select(filename, comparison, day, orientation_flag, comparison_label))
load_deg <- function(path, experiment, comparison_label, genotype, day, flip_direction,
padj_col = "padj", lfc_col = "log2FoldChange",
padj_thr = 0.05, lfc_thr = 1) {
df <- tryCatch(
read.csv(path, stringsAsFactors = FALSE),
error = function(e) { cat("FAILED to read:", path, "\n"); return(NULL) }
)
if (is.null(df)) return(NULL)
names(df) <- trimws(names(df))
if (!all(c(padj_col, lfc_col) %in% names(df))) {
cat("WARNING - missing expected columns in:", path, "\n")
return(NULL)
}
df_sig <- df %>%
filter(!is.na(.data[[padj_col]]),
.data[[padj_col]] < padj_thr,
abs(.data[[lfc_col]]) >= lfc_thr)
if (nrow(df_sig) == 0) {
cat("NOTE: 0 significant DEGs in:", path, "\n")
return(NULL)
}
df_sig %>%
mutate(
log2FoldChange_corrected = if (flip_direction) -.data[[lfc_col]] else .data[[lfc_col]],
experiment = experiment,
comparison = comparison_label,
genotype   = genotype,
day        = day,
direction  = if_else(log2FoldChange_corrected > 0, "up", "down")
)
}
# FIX: Explicitly map elements to avoid layout/position bugs from pmap
all_deg <- pmap_dfr(
list(
path             = deg_meta$path,
experiment       = deg_meta$experiment,
comparison_label = deg_meta$comparison_label,
genotype         = deg_meta$genotype,
day              = deg_meta$day,
flip_direction   = deg_meta$flip_direction,
filename         = deg_meta$filename,
orientation_flag = deg_meta$orientation_flag
),
function(path, experiment, comparison_label, genotype, day, flip_direction, filename, orientation_flag) {
cat("Loading:", filename, "(", orientation_flag, ")\n")
load_deg(path, experiment, comparison_label, genotype, day, flip_direction)
}
)
if (is.null(all_deg) || nrow(all_deg) == 0) {
stop("Zero significant DEGs found across all datasets. Processing halted.")
}
cat("\nTotal significant DEGs loaded (padj<0.05, |log2FC|>=1):", nrow(all_deg), "\n")
deg_by_comparison <- all_deg %>%
count(comparison, experiment, genotype, day, name = "n_DEG") %>%
arrange(experiment, genotype, day, comparison)
# FIXED: Removed broken curly-brace syntax and replaced with clean pipeline logic
deg_by_comparison_dir <- all_deg %>%
count(comparison, experiment, genotype, day, direction, name = "n_DEG") %>%
pivot_wider(names_from = direction, values_from = n_DEG, values_fill = 0)
# Safety check: if all genes were 'up' or all 'down', ensure both columns still exist
if (!"up" %in% names(deg_by_comparison_dir)) deg_by_comparison_dir$up <- 0
if (!"down" %in% names(deg_by_comparison_dir)) deg_by_comparison_dir$down <- 0
deg_by_comparison_dir <- deg_by_comparison_dir %>%
mutate(total_DEG = up + down) %>%
arrange(experiment, genotype, day, comparison)
cat("\n=== DEG counts by comparison (up/down) ===\n")
print(as.data.frame(deg_by_comparison_dir))
dir.create("Output", showWarnings = FALSE)
dir.create("Figure", showWarnings = FALSE)
write.csv(deg_by_comparison_dir, "Output/deg_counts_by_comparison.csv", row.names = FALSE)
cat("Saved: Output/deg_counts_by_comparison.csv\n")
p_total <- ggplot(deg_by_comparison,
aes(x = reorder(comparison, n_DEG), y = n_DEG, fill = experiment)) +
geom_col() +
geom_text(aes(label = n_DEG), hjust = -0.1, size = 3) +
coord_flip() +
facet_wrap(~ experiment, scales = "free_y", ncol = 1) + # free_y keeps coordinate flips clean
scale_fill_manual(values = c("Diet1" = "#3498db", "Diet2" = "#e67e22", "Hypoxia" = "#9b59b6")) +
labs(
title = "Total DEGs per comparison (padj < 0.05, |log2FC| >= 1)",
x = "Comparison", y = "Number of significant DEGs"
) +
theme_bw(base_size = 11) +
theme(legend.position = "none")
ggsave("Figure/DEG_counts_total_by_comparison.pdf", p_total, width = 10, height = 14)
cat("Saved: Figure/DEG_counts_total_by_comparison.pdf\n")
p_total
